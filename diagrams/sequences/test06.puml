@startuml
title Test 06 Ladron Bloquea Produccion\n Parte 1: Setup y Construcción del Poblado

actor Test
participant Jugador
participant Vertice
participant Hexagono
participant Tablero
participant Juego
participant Poblado

Test -> Jugador ** : <<create>> Jugador(1, "Maria", Color.YELLOW)
Test -> Vertice ** : <<create>> Vertice()
Test -> Hexagono ** : <<create>> Hexagono(Colina, 9)

Test -> Hexagono : agregarVertice(vertice)
activate Hexagono
Hexagono -> Hexagono : vertices.add(vertice)
Hexagono --> Test
deactivate Hexagono

Test -> Tablero ** : <<create>> Tablero(hexagonos)
Test -> Juego ** : <<create>> Juego(jugadores, tablero, null)

== Construcción del Poblado ==
Test -> Jugador : construirPrimerosPoblados(new Poblado, vertice)
activate Jugador

Jugador -> Poblado ** : <<create>> Poblado(jugador)

Jugador -> Poblado : aplicarCambioPrimerasColocaciones(jugador, vertice)
activate Poblado

Poblado -> Vertice : construirPobladoPrimerasColocaciones(jugador, this)
activate Vertice

Vertice -> Vertice : construccion.ocupar()
note right: NullConstruccion no lanza excepción

Vertice -> Vertice : validarDistancia()
Vertice -> Vertice : construccion = poblado

Vertice --> Poblado
deactivate Vertice

Poblado --> Jugador
deactivate Poblado

Jugador -> Jugador : agregarConstruccion(poblado)

Jugador --> Test
deactivate Jugador

@enduml

@startuml
title Test 06 - Parte 2: Colocación del Ladrón y Bloqueo de Producción

actor Test
participant Hexagono
participant StrategyConLadron
participant Juego
participant Tablero
participant Vertice

note over Test, StrategyConLadron #FFCCCC
   Se coloca el ladrón en el hexágono
  para bloquear la producción
end note

Test -> Hexagono : ponerLadron()
activate Hexagono

Hexagono -> StrategyConLadron **: <<create>> StrategyConLadron()
Hexagono -> Hexagono : estrategiaActual = StrategyConLadron

note right of Hexagono
  Se cambia la estrategia del hexágono
  de StrategySinLadron a StrategyConLadron
end note

Hexagono --> Test
deactivate Hexagono

Test -> Juego : producirRecursos(9)
activate Juego

Juego -> Tablero : producir(9)
activate Tablero

loop para cada hexágono
  Tablero -> Hexagono : producirRecursos(9)
  activate Hexagono

  Hexagono -> Hexagono : numero == 9 ?

  alt Número coincide
    Hexagono -> StrategyConLadron : producirRecursos(vertices, terreno)
    activate StrategyConLadron
    
    note right of StrategyConLadron #FFCCCC
      StrategyConLadron → método vacío
      NO produce recursos
    end note
    
    StrategyConLadron --> Hexagono
    deactivate StrategyConLadron

  else No coincide
    note right: No produce
  end

  Hexagono --> Tablero
  deactivate Hexagono
end

Tablero --> Juego
deactivate Tablero

Juego --> Test
deactivate Juego

note over Test
  No se produjo ningún recurso
  debido al ladrón
end note

@enduml

@startuml
title Test 06 - Parte 3: Verificación - Inventario Vacío y Excepción

actor Test
participant Jugador
participant Inventario
participant Ladrillo

Test -> Jugador : entregarRecursos([Ladrillo])
activate Jugador

Jugador -> Inventario : consumirRecurso(ladrillo)
activate Inventario

note right of Inventario
  Inventario vacío:
  no hay ladrillos
end note

Inventario -> Inventario : eliminarRecurso(ladrillo)

loop para cada recurso en inventario
  note right: No se encuentra el recurso
end

Inventario -> Inventario : throw RecursosInsuficientesError

Inventario --> Jugador : RecursosInsuficientesError
deactivate Inventario

Jugador --> Test : RecursosInsuficientesError
deactivate Jugador


@enduml

